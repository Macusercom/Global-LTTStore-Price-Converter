{
  "manifest_version": 3,
  "name": "Global LTTStore Price Converter",
  "version": "1.2.3",
  "description": "Shows local-currency prices next to CAD prices on global.lttstore.com product, cart, and checkout pages, using live rates from open.er-api.com. Currency, VAT rate, and include-VAT toggle are all configurable via the extension popup.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://open.er-api.com/*",
    "https://api.frankfurter.app/*",
    "https://global.lttstore.com/*",
    "https://checkout.shopify.com/*",
    "https://checkout.pci.shopifyinc.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LTTStore Price Converter Settings",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://global.lttstore.com/*",
        "https://checkout.shopify.com/*",
        "https://checkout.pci.shopifyinc.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
